# Preset for running GIFMe on your own machine only (localhost, or a home
# LAN you trust) - matches GIFMe's zero-config defaults, spelled out
# explicitly. If you're exposing this past localhost, use
# .env.selfhost.example instead.
#
# Copy to .env:
#   cp .env.local.example .env
# docker-compose.yml reads .env automatically. For a native run
# (./run.sh / run.bat), export these first: `set -a; source .env; set +a`.

# No auth - fine when only you (or people you trust) can reach this.
GIFME_USERNAME=
GIFME_PASSWORD=

# No upload size cap.
GIFME_MAX_UPLOAD_MB=0

# Never auto-delete job files - clear them yourself from the UI when you
# want the disk space back.
GIFME_JOB_TTL_HOURS=0

# Not needed - the frontend and API are served from the same origin.
GIFME_ALLOWED_ORIGINS=

# docker-compose only: what the "Output Folder" button reports since the
# container can't open a file manager on your host.
HOST_WORKDIR=
