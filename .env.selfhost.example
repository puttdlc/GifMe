# Preset for exposing GIFMe past localhost - behind a Cloudflare Tunnel,
# a reverse proxy, or any setup reachable from outside your machine.
# See the README's "Self-Host" section for the full walkthrough.
#
# Copy to .env:
#   cp .env.selfhost.example .env
# docker-compose.yml reads .env automatically. For a native run
# (./run.sh / run.bat), export these first: `set -a; source .env; set +a`.

# REQUIRED - GIFMe has no login of its own. Leaving either of these blank
# disables auth entirely, which defeats the point of this preset.
GIFME_USERNAME=
GIFME_PASSWORD=

# Reject uploads over this size (MB), so one upload can't fill the disk.
GIFME_MAX_UPLOAD_MB=500

# Delete a job's files this many hours after they were last touched, so
# disk usage stays bounded with no one around to click "clear".
GIFME_JOB_TTL_HOURS=24

# Comma-separated origins allowed to call the API cross-origin - only
# needed if you're calling the API from a different domain than the one
# serving the frontend. Leave unset for the standard same-origin setup.
GIFME_ALLOWED_ORIGINS=

# docker-compose only: what the "Output Folder" button reports since the
# container can't open a file manager on your host.
HOST_WORKDIR=
